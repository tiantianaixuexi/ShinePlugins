{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Novel Studio",
  "version": "0.1.0",
  "identifier": "com.ainovelstudio.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Novel Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "category": "Productivity",
    "shortDescription": "Local-first AI writing studio for long-form fiction",
    "longDescription": "AI Novel Studio is a local-first desktop application for planning, drafting and revising long-form fiction with the help of local or remote language models.",
    "publisher": "AI Novel Studio",
    "icon": ["icons/icon.ico", "icons/icon.png", "icons/32x32.png", "icons/128x128.png"]
  },
  "plugins": {}
}