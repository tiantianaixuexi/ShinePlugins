# Copy to `.env` and restart `pnpm dev`.
#
# Only used when the frontend runs in a browser (no Tauri shell). The desktop
# app ignores these: Rust injects the real port and a one-shot token itself.
#
# `dev-backend.ps1` uses this same token, so the Vite /api proxy can authenticate.
VITE_API_TOKEN=dev-token

# Leave empty to use the Vite proxy (relative /api requests).
VITE_API_BASE_URL=